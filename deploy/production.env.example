# Copy to .env.production (chmod 600). Use external TLS endpoints and real secrets.
API_PUBLIC_URL=https://budget.example.org
OIDC_ISSUER=https://login.example.org/realms/zerobudget
OIDC_CLIENT_ID=zerobudget
OIDC_CLIENT_SECRET=REPLACE
DATABASE_URL=postgres://zerobudget_runtime:REPLACE@postgres.example.org:5432/zerobudget?sslmode=verify-full
AUTH_REDIS_URL=rediss://default:REPLACE@redis.example.org:6379/0
AUTH_REDIS_NAMESPACE=zerobudget:production
DATABASE_MAX_CONNECTIONS=10
DATABASE_TIMEOUT_MS=3000
AUTH_REDIS_TIMEOUT_MS=3000
