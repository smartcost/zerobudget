{
  "openapi": "3.0.3",
  "info": {
    "title": "ZeroBudget API",
    "version": "0.1.0",
    "description": "Contrato do backend implementado. Sessão do servidor após login OIDC no Dex; permissões explícitas e isolamento por proprietário. Valores financeiros em centavos. Rotas HTML e assets de /auth/session são auxiliares e não fazem parte deste contrato JSON."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde"
    },
    {
      "name": "Autenticação"
    },
    {
      "name": "Ciclos"
    },
    {
      "name": "Envelopes"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness: confirma que o processo HTTP responde",
        "tags": [
          "Saúde"
        ],
        "security": [],
        "responses": {
          "204": {
            "description": "API responde; não verifica prontidão de Redis, Dex ou PostgreSQL."
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getSession",
        "summary": "Consultar sessão e permissões atuais",
        "tags": [
          "Autenticação"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Consultar sessão e permissões atuais",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revogar sessão e remover cookie",
        "tags": [
          "Autenticação"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "204": {
            "description": "Revogar sessão e remover cookie"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Csrf"
          },
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "description": "Exige sessão e CSRF; não encerra SSO no Dex. Não depende da disponibilidade do PostgreSQL."
      }
    },
    "/api/auth/login": {
      "get": {
        "operationId": "beginLogin",
        "summary": "Iniciar login no navegador pelo Dex",
        "tags": [
          "Autenticação"
        ],
        "security": [],
        "responses": {
          "303": {
            "description": "Redireciona ao Dex e define cookie temporário de login. Continuar no mesmo navegador.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "operationId": "finishLogin",
        "summary": "Callback OIDC, exclusivo do fluxo iniciado no navegador",
        "tags": [
          "Autenticação"
        ],
        "security": [],
        "responses": {
          "303": {
            "description": "Callback OIDC, exclusivo do fluxo iniciado no navegador",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "example": "/auth/session"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          }
        },
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Exige cookie temporário de login correspondente. State, código e tentativa são de uso único. Não chamar manualmente, nem copiar URLs de retorno ou códigos para a coleção."
      }
    },
    "/api/cycles": {
      "post": {
        "operationId": "createCycle",
        "summary": "Criar ciclo planejado",
        "tags": [
          "Ciclos"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "201": {
            "description": "Criar ciclo planejado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cycle"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "422": {
            "$ref": "#/components/responses/422"
          }
        },
        "description": "Exige budget:write. Proprietário determinado pela sessão autenticada. Datas estritas YYYY-MM-DD, anos 0001 a 9999; fim exclusivo posterior ao início. Períodos idênticos do mesmo proprietário retornam 409. Períodos diferentes sobrepostos são permitidos.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Csrf"
          },
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCycle"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listCycles",
        "summary": "Listar os próprios ciclos",
        "tags": [
          "Ciclos"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Listar os próprios ciclos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cycle"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "422": {
            "$ref": "#/components/responses/422"
          }
        },
        "description": "Exige budget:read. Proprietário determinado pela sessão autenticada. Ordem: period_start DESC, id DESC. Totais refletem os envelopes, não apenas a página deles.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ]
      }
    },
    "/api/cycles/{cycle_id}": {
      "get": {
        "operationId": "getCycle",
        "summary": "Consultar ciclo e totais",
        "tags": [
          "Ciclos"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Consultar ciclo e totais",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cycle"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "422": {
            "$ref": "#/components/responses/422"
          }
        },
        "description": "Exige budget:read. Proprietário determinado pela sessão autenticada."
      },
      "parameters": [
        {
          "name": "cycle_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/api/cycles/{cycle_id}/envelopes": {
      "post": {
        "operationId": "createEnvelope",
        "summary": "Criar envelope",
        "tags": [
          "Envelopes"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "201": {
            "description": "Criar envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "422": {
            "$ref": "#/components/responses/422"
          }
        },
        "description": "Exige budget:write. Proprietário determinado pela sessão autenticada.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Csrf"
          },
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEnvelope"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listEnvelopes",
        "summary": "Listar envelopes do ciclo",
        "tags": [
          "Envelopes"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Listar envelopes do ciclo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Envelope"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "422": {
            "$ref": "#/components/responses/422"
          }
        },
        "description": "Exige budget:read. Proprietário determinado pela sessão autenticada. Ordem por UUID crescente. Paginação por offset pode mudar entre consultas concorrentes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ]
      },
      "parameters": [
        {
          "name": "cycle_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/api/cycles/{cycle_id}/envelopes/{envelope_id}": {
      "patch": {
        "operationId": "updateEnvelope",
        "summary": "Alterar nome ou alocação do envelope",
        "tags": [
          "Envelopes"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Alterar nome ou alocação do envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "422": {
            "$ref": "#/components/responses/422"
          }
        },
        "description": "Exige budget:write. Proprietário determinado pela sessão autenticada. Ao menos um campo. Omitido preserva o valor; null é inválido. Reduções liberam saldo. A soma não pode exceder a renda, inclusive sob concorrência.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Csrf"
          },
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchEnvelope"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteEnvelope",
        "summary": "Remover envelope e liberar sua alocação",
        "tags": [
          "Envelopes"
        ],
        "security": [
          {
            "LocalSession": []
          },
          {
            "SecureSession": []
          }
        ],
        "responses": {
          "204": {
            "description": "Remover envelope e liberar sua alocação"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
