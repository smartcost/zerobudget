        },
        {
          "name": "envelope_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "budget:read",
                "budget:write"
              ]
            }
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Expiração da sessão, em segundos Unix."
          },
          "csrf_token": {
            "type": "string",
            "description": "Segredo da sessão para X-CSRF-Token. Não publicar."
          }
        },
        "required": [
          "user_id",
          "permissions",
          "issuer",
          "subject",
          "expires_at",
          "csrf_token"
        ],
        "additionalProperties": false
      },
      "CreateCycle": {
        "type": "object",
        "properties": {
          "period_start": {
            "type": "string",
            "format": "date",
            "example": "2026-10-01"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "example": "2026-11-01"
          },
          "income_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Centavos inteiros não negativos. Para aritmética em clientes JavaScript, limite-se a Number.MAX_SAFE_INTEGER ou utilize um parser de inteiros de 64 bits."
          }
        },
        "required": [
          "period_start",
          "period_end",
          "income_cents"
        ],
        "additionalProperties": false
      },
      "Cycle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "period_start": {
            "type": "string",
            "format": "date"
          },
          "period_end": {
            "type": "string",
            "format": "date"
          },
          "income_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Centavos inteiros não negativos. Para aritmética em clientes JavaScript, limite-se a Number.MAX_SAFE_INTEGER ou utilize um parser de inteiros de 64 bits."
          },
          "allocated_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Centavos inteiros não negativos. Para aritmética em clientes JavaScript, limite-se a Number.MAX_SAFE_INTEGER ou utilize um parser de inteiros de 64 bits."
          },
          "available_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Centavos inteiros não negativos. Para aritmética em clientes JavaScript, limite-se a Number.MAX_SAFE_INTEGER ou utilize um parser de inteiros de 64 bits."
          },
          "currency": {
            "type": "string",
            "enum": [
              "BRL"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned"
            ]
          }
        },
        "required": [
          "id",
          "period_start",
          "period_end",
          "income_cents",
          "allocated_cents",
          "available_cents",
          "currency",
          "status"
        ],
        "additionalProperties": false
      },
      "CreateEnvelope": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Aparado, sem caracteres de controle. Único por ciclo, com distinção entre maiúsculas e minúsculas."
          },
          "allocated_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Centavos inteiros não negativos. Para aritmética em clientes JavaScript, limite-se a Number.MAX_SAFE_INTEGER ou utilize um parser de inteiros de 64 bits."
          }
        },
        "required": [
          "name",
          "allocated_cents"
        ],
        "additionalProperties": false
      },
      "Envelope": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cycle_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "allocated_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Centavos inteiros não negativos. Para aritmética em clientes JavaScript, limite-se a Number.MAX_SAFE_INTEGER ou utilize um parser de inteiros de 64 bits."
          }
        },
        "required": [
          "id",
          "cycle_id",
          "name",
          "allocated_cents"
        ],
        "additionalProperties": false
      },
      "PatchEnvelope": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Aparado, sem caracteres de controle. Único por ciclo, com distinção entre maiúsculas e minúsculas."
          },
          "allocated_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Centavos inteiros não negativos. Para aritmética em clientes JavaScript, limite-se a Number.MAX_SAFE_INTEGER ou utilize um parser de inteiros de 64 bits."
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      }
    },
    "securitySchemes": {
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "zb_session",
        "description": "Cookie HttpOnly local, obtido após callback do Dex. Em HTTPS o nome é __Host-zb_session; nunca use bearer do Dex nas rotas de negócio."
      },
      "SecureSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-zb_session",
        "description": "Sessão em HTTPS, alternativa ao cookie local."
      }
    },
    "parameters": {
      "Csrf": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Obtido por GET /api/auth/me na mesma sessão."
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "description": "Se presente, deve ser exatamente API_PUBLIC_URL. Nenhuma origem CORS adicional é habilitada."
      }
    },
    "responses": {
      "400": {
        "description": "IDs, query string, cookies ou callback malformados.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "401": {
        "description": "Sessão ausente, expirada ou identidade inválida.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Permissão insuficiente, conta bloqueada, CSRF ou origem inválidos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Recurso inexistente, de outro proprietário ou de outro ciclo.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Período ou nome duplicado, ou alocação acima da renda.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "500": {
        "description": "Erro de configuração interna.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "Dependência indisponível; sem fallback automático.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "413": {
        "description": "Corpo acima de 4096 bytes.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "415": {
        "description": "Content-Type deve ser application/json.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "422": {
        "description": "Entrada inválida. Erros de domínio são JSON; rejeições de desserialização podem ser texto simples.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
